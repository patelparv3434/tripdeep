DATABASE_BACKEND=postgres
POSTGRES_DSN=host=127.0.0.1 port=5432 dbname=tripdeep user=postgres
ENVIRONMENT=development
APP_VERSION=0.1.0
CORS_ORIGINS=["http://localhost:5173"]
UPLOAD_MAX_BYTES=10485760
UPLOAD_DIRECTORY=var/uploads
MAX_AGENT_RETRIES=2
AGENT_TIMEOUT_SECONDS=30
AIRPORT_RADIUS_KM=20

# Supabase Auth and PostgreSQL configuration for production.
# Use a project URL, publishable/anon key, server-only service-role key,
# and a TLS-enabled Supabase Postgres connection string.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=tripdeep-documents
POSTGRES_DSN=
# Set this to the exact deployed frontend origin, for example:
# CORS_ORIGINS=["https://your-project.pages.dev"]
# Optional free-quota model for non-sensitive clothing tips only.
# It receives coarse weather and generic activity types only and requires
# a user opt-in for each trip before any prompt is sent.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct

# Frontend build-time variables (publishable key only).
VITE_API_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_CLOUD_AI_ENABLED=false

# Optional integrations. Leave unset to keep unsupported providers explicitly unavailable.
GOOGLE_WEATHER_API_KEY=
GOOGLE_MAPS_API_KEY=
GOIBIBO_API_KEY=
MAKEMYTRIP_API_KEY=
# Local Ollama is suitable only when the API host has Ollama installed and reachable.
# Keep disabled on free cloud hosts unless an explicitly approved hosted provider is added.
LLM_PROVIDER=none
LLM_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
